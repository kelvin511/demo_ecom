{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Backend (Local)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/server.js",
      "restart": true,
      "env": {
        "PORT": "5000",
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Test Suite (Quantity Validation)",
      "program": "${workspaceFolder}/scripts/test-runner.js",
      "console": "integratedTerminal"
    }
  ]
}

{
  "name": "demo-ecom-backend",
  "version": "1.0.0",
  "description": "Local commerce backend with synthetic products and resettable cart for API validation",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
